.env.*
!.env.example
*.pem
*.key
*.crt
*.local.yaml
server/config/config.yaml
# 构建产物
dist/
build/
server/bin/
# demo 可执行产物（根锚定，仅匹配 server 下名为 demo 的二进制，不影响 server/examples/demo/ 源码目录）
/server/demo
# demo LocalDriver 本地存储根（运行时上传数据目录；NewLocalDriver 启动自动 MkdirAll 重建，无需 .gitkeep）
/server/uploads/
# demo 实际落盘目录（root_dir "./uploads" 相对 demo 工作目录，T-007f §8-4）
/server/examples/demo/uploads/
*.log
