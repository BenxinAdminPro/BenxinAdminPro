# 应用标题
VITE_APP_TITLE=BenxinAdminPro

# API 基地址：留空 = 走 Vite 开发代理（同源 /auth /sys，免 CORS）。
# 生产构建时在 .env.local / .env.production 填后端真实地址，如 https://api.example.com
VITE_API_BASE_URL=

# 开发代理目标（仅 dev 生效）；默认后端 demo :8080，可在 .env.local 覆盖
VITE_PROXY_TARGET=http://localhost:8080
